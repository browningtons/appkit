{
  "name": "@browningtons/appkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Shared paywall + entitlement starter for shipping small monetized React apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browningtons/appkit.git"
  },
  "files": [
    "dist",
    "supabase"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./verify-purchase": {
      "types": "./dist/verify-purchase.d.ts",
      "import": "./dist/verify-purchase.js"
    },
    "./stripe-webhook": {
      "types": "./dist/stripe-webhook.d.ts",
      "import": "./dist/stripe-webhook.js"
    },
    "./migrations/*": "./supabase/migrations/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsup",
    "prepare": "tsup",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.511.0",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.7.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.8"
  }
}
