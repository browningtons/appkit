{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": false,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/kit",
    "src/stripe.d.ts",
    "api/_lib.ts",
    "api/verify-purchase.ts",
    "api/stripe-webhook.ts"
  ]
}
